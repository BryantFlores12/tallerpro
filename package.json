{
  "name": "tallerpro-backend",
  "version": "1.0.0",
  "description": "API del Sistema de Gestión de Taller Mecánico TallerPro",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:reset": "node src/database/migrate.js --confirm-reset",
    "db:reset:seed": "node src/database/migrate.js --confirm-reset --seed",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
